<?xml version="1.0"?>
<sdf version="1.7">
  <model name="inspection_tracked_robot">
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0112</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0172</iyy>
          <iyz>0</iyz>
          <izz>0.0252</izz>
        </inertia>
      </inertial>
      <collision name="footprint_collision">
        <geometry>
          <box>
            <size>0.25 0.196 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.22 0.13 0.075</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.22 0.25 1</ambient>
          <diffuse>0.18 0.22 0.25 1</diffuse>
          <specular>0.05 0.06 0.06 1</specular>
        </material>
      </visual>
      <visual name="left_track_visual">
        <pose>0 0.083 -0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.27 0.030 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.035 0.035 0.035 1</ambient>
          <diffuse>0.035 0.035 0.035 1</diffuse>
        </material>
      </visual>
      <visual name="right_track_visual">
        <pose>0 -0.083 -0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.27 0.030 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.035 0.035 0.035 1</ambient>
          <diffuse>0.035 0.035 0.035 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_drive_wheel">
      <pose>0 0.115 -0.015 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.00009</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00009</iyy>
          <iyz>0</iyz>
          <izz>0.000153</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="right_drive_wheel">
      <pose>0 -0.115 -0.015 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.00009</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00009</iyy>
          <iyz>0</iyz>
          <izz>0.000153</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_skid">
      <pose>0.095 0 -0.038 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="rear_skid">
      <pose>-0.095 0 -0.038 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="laser">
      <pose>0 0 0.10 0 0 3.1415926</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0.62 0.28 1</ambient>
          <diffuse>0 0.62 0.28 1</diffuse>
        </material>
      </visual>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00005</iyy>
          <iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <sensor name="scan" type="gpu_lidar">
        <topic>/scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <link name="imu_link">
      <pose>-0.125 -0.031 0.040 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.025 0.018 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.34 0.72 1</ambient>
          <diffuse>0.1 0.34 0.72 1</diffuse>
        </material>
      </visual>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <topic>/sim/imu/data_raw</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_drive_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_drive_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="front_skid_joint" type="ball">
      <parent>base_link</parent>
      <child>front_skid</child>
    </joint>

    <joint name="rear_skid_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_skid</child>
    </joint>

    <joint name="base_to_laser" type="fixed">
      <parent>base_link</parent>
      <child>laser</child>
    </joint>

    <joint name="base_to_imu" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel_odom</odom_topic>
      <tf_topic>/wheel_odom_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.35</max_linear_acceleration>
      <min_linear_acceleration>-0.45</min_linear_acceleration>
      <max_angular_acceleration>0.70</max_angular_acceleration>
      <min_angular_acceleration>-0.90</min_angular_acceleration>
      <max_linear_velocity>0.18</max_linear_velocity>
      <min_linear_velocity>-0.18</min_linear_velocity>
      <max_angular_velocity>0.55</max_angular_velocity>
      <min_angular_velocity>-0.55</min_angular_velocity>
    </plugin>
  </model>
</sdf>
