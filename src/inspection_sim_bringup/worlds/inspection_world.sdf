<?xml version="1.0"?>
<sdf version="1.7">
  <world name="inspection_world">
    <physics name="inspection_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.75 0.78 0.80 1</ambient>
      <background>0.86 0.88 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 8</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 8</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.56 0.54 1</ambient>
            <diffuse>0.55 0.56 0.54 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="inspection_area">
      <static>true</static>
      <link name="walls_and_obstacles">
        <collision name="north_wall_collision">
          <pose>0 2.0 0.25 0 0 0</pose>
          <geometry><box><size>6.0 0.08 0.5</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 2.0 0.25 0 0 0</pose>
          <geometry><box><size>6.0 0.08 0.5</size></box></geometry>
          <material><ambient>0.56 0.58 0.60 1</ambient><diffuse>0.56 0.58 0.60 1</diffuse></material>
        </visual>

        <collision name="south_wall_collision">
          <pose>0 -2.0 0.25 0 0 0</pose>
          <geometry><box><size>6.0 0.08 0.5</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -2.0 0.25 0 0 0</pose>
          <geometry><box><size>6.0 0.08 0.5</size></box></geometry>
          <material><ambient>0.56 0.58 0.60 1</ambient><diffuse>0.56 0.58 0.60 1</diffuse></material>
        </visual>

        <collision name="west_wall_collision">
          <pose>-3.0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.08 4.0 0.5</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-3.0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.08 4.0 0.5</size></box></geometry>
          <material><ambient>0.56 0.58 0.60 1</ambient><diffuse>0.56 0.58 0.60 1</diffuse></material>
        </visual>

        <collision name="east_wall_collision">
          <pose>3.0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.08 4.0 0.5</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>3.0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.08 4.0 0.5</size></box></geometry>
          <material><ambient>0.56 0.58 0.60 1</ambient><diffuse>0.56 0.58 0.60 1</diffuse></material>
        </visual>

        <collision name="inspection_panel_a_collision">
          <pose>-1.35 0.70 0.25 0 0 0.35</pose>
          <geometry><box><size>0.28 1.10 0.50</size></box></geometry>
        </collision>
        <visual name="inspection_panel_a_visual">
          <pose>-1.35 0.70 0.25 0 0 0.35</pose>
          <geometry><box><size>0.28 1.10 0.50</size></box></geometry>
          <material><ambient>0.42 0.49 0.53 1</ambient><diffuse>0.42 0.49 0.53 1</diffuse></material>
        </visual>

        <collision name="inspection_panel_b_collision">
          <pose>1.45 -0.85 0.25 0 0 -0.25</pose>
          <geometry><box><size>0.30 1.20 0.50</size></box></geometry>
        </collision>
        <visual name="inspection_panel_b_visual">
          <pose>1.45 -0.85 0.25 0 0 -0.25</pose>
          <geometry><box><size>0.30 1.20 0.50</size></box></geometry>
          <material><ambient>0.42 0.49 0.53 1</ambient><diffuse>0.42 0.49 0.53 1</diffuse></material>
        </visual>

        <collision name="round_column_collision">
          <pose>0.75 0.85 0.30 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.60</length></cylinder></geometry>
        </collision>
        <visual name="round_column_visual">
          <pose>0.75 0.85 0.30 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.60</length></cylinder></geometry>
          <material><ambient>0.62 0.45 0.29 1</ambient><diffuse>0.62 0.45 0.29 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
